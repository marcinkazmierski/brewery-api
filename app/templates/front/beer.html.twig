{% extends 'base.html.twig' %}

{% block body %}
    <div class="header text-center">
        <h1 class="mt-3">Jasny Kruk</h1>
        <p class="lead">Wyjątkowe piwo domowe dla koneserów.</p>
        <img src="https://raw.githubusercontent.com/marcinkazmierski/brewery-app/main/brewery/assets/images/poster_1.jpg"
             alt="Etykieta Jasny Kruk">
    </div>

    <div class="container mb-5">
        <div class="row">
            <div class="col-md-4 text-center features">
                <h2>Unikalny smak</h2>
                <p>Delikatna goryczka i aromatyczne nuty cytrusów.</p>
            </div>
            <div class="col-md-4 text-center features">
                <h2>Naturalne składniki</h2>
                <p>100% naturalne składniki, bez sztucznych dodatków.</p>
            </div>
            <div class="col-md-4 text-center features">
                <div class="row">
                    <div class="col-12">
                        <h2>Parametry:</h2>
                    </div>
                </div>
                <div class="row">
                    <div class="col-6">
                        <h5>Goryczka:</h5>
                    </div>
                    <div class="col-6">
                        <div class="progress mt-1">
                            <div class="progress-bar bg-danger" role="progressbar" style="width: 60%;"
                                 aria-valuenow="25" aria-valuemin="0" aria-valuemax="100">41 IBU
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-6">
                        <h5>Zawartość alkoholu:</h5>
                    </div>
                    <div class="col-6">
                        <div class="progress mt-1">
                            <div class="progress-bar bg-warning" role="progressbar" style="width: 80%;"
                                 aria-valuenow="25" aria-valuemin="0" aria-valuemax="100">4.8 %
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    {% include 'front/sections/mobile-app-info.html.twig' %}

{% endblock %}


